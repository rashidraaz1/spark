# Cloudflare API Configuration
# Add these variables to your .env file

# Your Cloudflare account email
CLOUDFLARE_EMAIL=your-cloudflare-email@example.com

# Your Cloudflare Global API Key
# Get this from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=your-global-api-key-here

# Alternative: Use API Token instead (recommended for better security)
# CLOUDFLARE_API_TOKEN=your-api-token-here

# Note: If you use API Token, you'll need to modify the controller
# to use the token-based authentication instead of email + API key